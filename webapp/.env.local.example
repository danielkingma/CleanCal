# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Optional: only needed for automatic (Vercel Cron) calendar sync. ---
# Without these, iCal feeds still work fine via the "Sync now" / "Sync all
# feeds" buttons on the Properties page -- just not on a schedule.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. Keep it out of
# NEXT_PUBLIC_* (never sent to the browser), out of the repo, and only set
# it where the cron route actually runs (e.g. Vercel project env vars).
# From Project Settings -> API -> service_role key.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# A random secret you generate yourself (e.g. `openssl rand -hex 32`).
# Vercel Cron automatically sends it as `Authorization: Bearer <value>`
# when this env var is set, which is how /api/cron/sync-ical checks the
# request is really from your own scheduled job and not the public internet.
# CRON_SECRET=
